# Server Port Configuration
PORT=5000
NODE_ENV=development

# Database connection URL (Neon / PostgreSQL)
# Example: postgresql://user:password@host:port/dbname?sslmode=require
# IMPORTANT: if you connect through Neon's pooled "-pooler" endpoint (PgBouncer,
# transaction-pooling mode), you MUST add pgbouncer=true or Prisma's server-side
# prepared statements will randomly collide across reused connections. This is the
# #1 cause of Neon showing "healthy/idle" while the app still throws "Database error
# occurred" on login, save, or favorite/unfavorite actions.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/driply?schema=public&pgbouncer=true&connect_timeout=15

# Authentication Security Secrets
# Generate random 32+ character strings (e.g. openssl rand -base64 32)
JWT_SECRET=super_secret_access_token_key_change_me
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_me

# Cloudinary Integration for Media Uploads
CLOUDINARY_CLOUD_NAME=driply_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini AI (required for clothing identification and smart outfit suggestions)
GEMINI_API_KEY=your_gemini_api_key
